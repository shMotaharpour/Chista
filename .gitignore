__pycache__/
*.pyc

# The project venv AGENTS.md names (`.venv/`, Python 3.11). Ignored here
# because it is machine-specific and thousands of files; the stack that
# belongs in the repo is requirements.txt.
.venv/

# Generated artifacts (replays from world.kaggle_env, benchmark output)
artifacts/

# Local scratch (agent working files, not part of the project)
.hermes/
.docs_diff.py
.docs_watch_state.json

# The tuned numbers ship beside the agent; they come out of the ignore
# list once they stop moving (agent/config.py has the committed defaults).
agent/artifact/config.json

# graphify knowledge graph: NONE of it is tracked. It is a build artifact - `graphify` regenerates
# it from the code in one command - and the tracked copies were 36 MB of JSON and HTML whose diff
# swamped every real change (a regeneration moved ~56,000 lines). The per-run subdirectories were
# already ignored; the outputs are now ignored with them.
graphify-out/cache/
graphify-out/2026-*/
graphify-out/.graphify_ast.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_chunk_*.files.txt
graphify-out/.graphify_cached.json
graphify-out/.graphify_semantic_new.json
